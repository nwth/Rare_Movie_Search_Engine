# CineSeeker Configuration
# Copy to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Redis (for Celery & Cache)
REDIS_URL=redis://localhost:6379/0

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cineseeker

# Image Search API Keys
YANDEX_API_KEY=
SERPAPI_KEY=b9687056aeeec9b2bad9c145808896bd9b76a379ce6858618a372057e68c1057

# Image Hosting (free, for local file uploads → public URL → SerpApi)
# Get free key at: https://imgbb.com/api
IMGBB_API_KEY=

# Movie Metadata API Keys (free tier available)
TMDB_API_KEY=
OMDB_API_KEY=

# Search Engine Settings
GOOGLE_DORK_TIMEOUT=10
MAX_SEARCH_RESULTS=50
CONCURRENT_CRAWLERS=5
